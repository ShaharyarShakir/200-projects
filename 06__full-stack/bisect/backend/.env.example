PROJECT_NAME=Bisect
ENVIRONMENT=development
API_V1_STR=/api/v1
LOG_LEVEL=INFO

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/bisect
DATABASE_ECHO=false
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# CORS
CORS_ORIGINS=["http://localhost:3000", "http://127.0.0.1:3000"]

# GitHub OAuth
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret
GITHUB_REDIRECT_URI=http://localhost:3000/auth/callback

# Security & Cryptography
ENCRYPTION_SECRET_KEY=i2_x1szObisCwZwpi3tCtg8FjNh-SyANThdSUbF07QY=
JWT_SECRET_KEY=your-secure-random-jwt-secret-key
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

# AI Agent (Groq)
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=llama-3.3-70b-versatile

# Podman Sandbox
PODMAN_SOCKET=/run/user/1000/podman/podman.sock
SANDBOX_BASE_IMAGE=python:3.12-slim
SANDBOX_TIMEOUT_SECONDS=120
SANDBOX_MEMORY_LIMIT=1g
SANDBOX_NETWORK_DISABLED=true
