{
  "name": "cloudflare-waitlist",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "client": "bun run --bun astro dev",
    "build:client": "bun run --bun astro build",
    "preview": "astro preview",
    "astro": "astro",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint 'src/**/*.{js,ts,tsx,astro}'",
    "worker": "wrangler dev",
    "dev": "concurrently \"bun client\" \"bun  worker\"",
    "dryrun:stagging": "bun run build:client && wrangler deploy --dry-run --env stagging",
    "dryrun:prod": "bun run build:client && wrangler deploy --dry-run --env production",
    "deploy:stagging": "bun run build:client && wrangler deploy  --env stagging",
    "deploy:prod": "bun run build:client && wrangler deploy  --env production",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply dojo_local_db --local",
    "db:migrate:stagging": "wrangler d1 migrations apply dojo_stagging_db --remote --env stagging",
    "create:test:db": "bun run ./scripts/create-test-db.ts",
    "destroy:test:db": "bun run ./scripts/delete-test-db.ts",
    "test": "bun create:test:db && bun test && bun destroy:test:db"
  },
  "dependencies": {
    "@astrojs/react": "^5.0.3",
    "@tailwindcss/vite": "^4.2.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "astro": "6.1.8",
    "concurrently": "^9.2.1",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.12.14",
    "jose": "^6.2.2",
    "lucide-react": "^1.8.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "tailwindcss": "^4.2.3",
    "wrangler": "^4.84.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260422.1",
    "@types/bun": "^1.3.12",
    "@typescript-eslint/parser": "^8.59.0",
    "daisyui": "^5.5.19",
    "drizzle-kit": "^0.31.10",
    "drizzle-seed": "^0.3.1",
    "eslint": "^9.39.4",
    "eslint-plugin-astro": "^1.7.0",
    "prettier": "^3.8.3",
    "prettier-plugin-astro": "^0.14.1",
    "prettier-plugin-tailwindcss": "^0.7.2"
  }
}